<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold mb-2">セッション履歴</h1>
    <p class="text-gray-600">過去のチェックイン・チェックアウト記録</p>
  </div>

  <% if @sessions.any? %>
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-100 border-b">
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">日時</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">座席</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">ルーム</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">チェックイン</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">チェックアウト</th>
              <th class="px-6 py-3 text-right text-sm font-semibold text-gray-900">滞在時間</th>
              <th class="px-6 py-3 text-center text-sm font-semibold text-gray-900">ステータス</th>
            </tr>
          </thead>
          <tbody>
            <% @sessions.each do |session| %>
              <tr class="border-b hover:bg-gray-50">
                <td class="px-6 py-4 text-sm text-gray-500">
                  <%= l(session.created_at, format: :short) %>
                </td>
                <td class="px-6 py-4 text-sm font-medium text-gray-900">
                  <%= session.seat.seat_identifier %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900">
                  <%= session.room.name %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900">
                  <%= session.check_in_time.strftime("%H:%M") %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900">
                  <% if session.check_out_time %>
                    <%= session.check_out_time.strftime("%H:%M") %>
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-sm text-right font-medium text-gray-900">
                  <% duration = session.duration %>
                  <% hours = (duration / 3600).to_i %>
                  <% minutes = ((duration % 3600) / 60).to_i %>
                  <%= "#{hours}h #{minutes}m" %>
                </td>
                <td class="px-6 py-4 text-center">
                  <% if session.checked_out? %>
                    <span class="inline-block px-3 py-1 text-xs font-medium text-green-800 bg-green-100 rounded-full">
                      チェックアウト
                    </span>
                  <% elsif session.timed_out? %>
                    <span class="inline-block px-3 py-1 text-xs font-medium text-yellow-800 bg-yellow-100 rounded-full">
                      タイムアウト
                    </span>
                  <% else %>
                    <span class="inline-block px-3 py-1 text-xs font-medium text-blue-800 bg-blue-100 rounded-full">
                      アクティブ
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ページネーション -->
    <% if @sessions.respond_to?(:total_pages) %>
      <div class="mt-6 flex justify-center">
        <%= paginate @sessions %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white rounded-lg shadow-lg p-12 text-center">
      <div class="mb-4">
        <svg class="mx-auto w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <p class="text-xl text-gray-600 mb-4">セッション記録がありません</p>
      <p class="text-gray-500 mb-6">これまでのチェックイン・チェックアウト記録が表示されます</p>
      <%= link_to "チェックインを開始", check_in_form_sessions_path, class: "inline-block px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors" %>
    </div>
  <% end %>

  <div class="mt-8 bg-blue-50 border-l-4 border-blue-500 p-4 rounded">
    <h2 class="font-bold text-blue-900 mb-2">滞在時間について</h2>
    <p class="text-sm text-blue-700">
      滞在時間はチェックアウト時刻 - チェックイン時刻で計算されます。
      タイムアウトの場合は最後の記録時刻までの時間です。
    </p>
  </div>
</div>
