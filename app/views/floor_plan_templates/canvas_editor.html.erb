<style>
  .editor-container {
    background-color: #f8fafc;
    min-height: calc(100vh - 64px);
    padding: 32px 64px;
  }

  .editor-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .editor-title {
    font-size: 28px;
    font-weight: bold;
    color: #0f172a;
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #64748b;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }

  .back-link:hover {
    color: #334155;
  }

  .editor-toolbar {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 16px;
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .toolbar-group {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .toolbar-divider {
    width: 1px;
    height: 24px;
    background-color: #e2e8f0;
  }

  .toolbar-button {
    background: white;
    border: 1px solid #e2e8f0;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 500;
    font-size: 13px;
    color: #475569;
    display: flex;
    gap: 4px;
    align-items: center;
    transition: all 0.2s;
  }

  .toolbar-button:hover {
    background-color: #f8fafc;
    border-color: #cbd5e1;
  }

  .toolbar-button.active {
    background-color: #3b82f6;
    color: white;
    border-color: #3b82f6;
  }

  .color-btn {
    width: 32px;
    height: 32px;
    border: 3px solid #64748b;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .color-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.2);
  }

  .color-btn.active {
    box-shadow: 0 0 0 3px #22c55e, 0 0 8px rgba(34, 197, 94, 0.4);
    transform: scale(1.15);
  }

  .zoom-btn {
    padding: 4px 8px;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background: white;
    cursor: pointer;
    font-weight: bold;
    font-size: 13px;
    transition: all 0.2s;
  }

  .zoom-btn:hover {
    background-color: #cffafe;
    border-color: #06b6d4;
  }

  .save-btn {
    padding: 6px 12px;
    background-color: #10b981;
    color: white;
    border: 1px solid #10b981;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 500;
    font-size: 13px;
    display: flex;
    gap: 4px;
    align-items: center;
    transition: all 0.2s;
  }

  .save-btn:hover {
    background-color: #059669;
  }


  .canvas-wrapper {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 32px;
    min-height: calc(100vh - 280px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  canvas {
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    background-color: #ffffff;
    width: 100%;
    height: 100%;
    display: block;
    cursor: default;
  }

  canvas.draw-mode {
    cursor: crosshair;
  }

  canvas.delete-mode {
    cursor: not-allowed;
  }
</style>

<script>
  window.currentEditMode = 'select';
  window.currentFigureType = 'rectangle';
  window.currentColor = '#3b82f6';
  window.zoomLevel = 100;
  window.gridEnabled = false;

  function setEditMode(mode) {
    window.currentEditMode = mode;

    // ボタン状態を更新
    document.querySelectorAll('.toolbar-button').forEach(btn => {
      btn.classList.remove('active');
    });
    document.getElementById(`mode-${mode}`)?.classList.add('active');

    // Canvas カーソルを変更
    const canvas = document.querySelector('canvas');
    if (canvas) {
      canvas.classList.remove('draw-mode', 'delete-mode');
      if (mode === 'draw') {
        canvas.classList.add('draw-mode');
      } else if (mode === 'delete') {
        canvas.classList.add('delete-mode');
      }
    }
  }

  function setDrawMode(figureType) {
    window.currentEditMode = 'draw';
    window.currentFigureType = figureType;

    console.log('[Canvas Editor] Figure selected:', figureType);

    // 全てのボタンをアクティブから削除
    document.querySelectorAll('.toolbar-button').forEach(btn => {
      btn.classList.remove('active');
    });

    // 選択した図形ボタンをアクティブに
    const buttonId = `mode-${figureType}`;
    document.getElementById(buttonId)?.classList.add('active');

    // Canvas カーソルを変更
    const canvas = document.querySelector('canvas');
    if (canvas) {
      canvas.classList.add('draw-mode');
      canvas.classList.remove('delete-mode');
    }
  }

  function setColor(color) {
    window.currentColor = color;
    document.querySelectorAll('.color-btn').forEach(btn => {
      btn.classList.remove('active');
    });
    document.querySelector(`[data-color="${color}"]`)?.classList.add('active');
  }

  function undoAction() {
    console.log('Undo triggered');
    alert('Undo 機能は準備中です');
  }

  function redoAction() {
    console.log('Redo triggered');
    alert('Redo 機能は準備中です');
  }

  function toggleGrid() {
    window.gridEnabled = !window.gridEnabled;
    const btn = event.target.closest('button');
    btn.style.opacity = window.gridEnabled ? '1' : '0.6';
  }

  function zoomOut() {
    if (window.zoomLevel > 50) {
      window.zoomLevel -= 10;
      updateZoomDisplay();
    }
  }

  function zoomIn() {
    if (window.zoomLevel < 200) {
      window.zoomLevel += 10;
      updateZoomDisplay();
    }
  }

  function resetZoom() {
    window.zoomLevel = 100;
    updateZoomDisplay();
  }

  function updateZoomDisplay() {
    document.getElementById('zoom-level').textContent = window.zoomLevel + '%';
    const canvas = document.querySelector('canvas');
    if (canvas) {
      canvas.style.transform = `scale(${window.zoomLevel / 100})`;
      canvas.style.transformOrigin = 'top center';
    }
  }

  // キーボードショートカット
  document.addEventListener('keydown', (e) => {
    if (e.key === 's' || e.key === 'S') setEditMode('select');
    if (e.key === 'd' || e.key === 'D') setEditMode('draw');
    if (e.key === 'Delete') setEditMode('delete');
  });

  // 初期化
  document.addEventListener('DOMContentLoaded', () => {
    setEditMode('select');
    setColor('#3b82f6');
  });
</script>

<div class="editor-container">
  <div class="editor-header">
    <div>
      <%= link_to "← 戻る", floor_plan_templates_path, class: "back-link" %>
    </div>
    <h1 class="editor-title">上面図エディター</h1>
  </div>

  <!-- Editor Toolbar -->
  <div class="editor-toolbar">
    <!-- モード選択 -->
    <div class="toolbar-group">
      <span style="font-size: 12px; color: #64748b; font-weight: 600;">モード:</span>
      <button class="toolbar-button active" onclick="setEditMode('select')" id="mode-select" title="選択モード (S)">
        ✓ 選択
      </button>

    </div>

    <!-- 図形ツール -->
    <div class="toolbar-group">
      <span style="font-size: 12px; color: #64748b; font-weight: 600;">図形:</span>
      <button class="toolbar-button" onclick="setDrawMode('rectangle')" id="mode-rectangle" title="矩形描画">
        ▭ 矩形
      </button>
      <button class="toolbar-button" onclick="setDrawMode('line')" id="mode-line" title="直線描画">
        — 直線
      </button>
      <button class="toolbar-button" onclick="setDrawMode('circle')" id="mode-circle" title="円描画">
        ● 円
      </button>
      <button class="toolbar-button" onclick="setDrawMode('arrow')" id="mode-arrow" title="矢印描画">
        → 矢印
      </button>
      <button class="toolbar-button" onclick="setDrawMode('text')" id="mode-text" title="テキスト配置">
        T テキスト
      </button>
      <button class="toolbar-button" onclick="setDrawMode('polygon')" id="mode-polygon" title="ポリゴン描画">
        ▲ ポリゴン
      </button>
      <button class="toolbar-button" onclick="setDrawMode('fill')" id="mode-fill" title="塗りつぶし">
        🪣 塗りつぶし
      </button>
    </div>

    <div class="toolbar-divider"></div>

    <!-- 削除モード -->
    <div class="toolbar-group">
      <button class="toolbar-button" onclick="setEditMode('delete')" id="mode-delete" title="削除モード (Del)">
        🗑️ 削除
      </button>
    </div>

    <div class="toolbar-divider"></div>

    <!-- Undo/Redo -->
    <div class="toolbar-group">
      <button class="toolbar-button" onclick="undoAction()" title="戻す (Ctrl+Z)">
        ↶ 戻す
      </button>
      <button class="toolbar-button" onclick="redoAction()" title="やり直す (Ctrl+Y)">
        ↷ やり直す
      </button>
    </div>

    <div class="toolbar-divider"></div>

    <!-- 色選択 -->
    <div class="toolbar-group">
      <span style="font-size: 12px; color: #64748b; font-weight: 600;">色:</span>
      <button class="color-btn" data-color="#3b82f6" title="青" onclick="setColor('#3b82f6')" style="background-color: #3b82f6;"></button>
      <button class="color-btn" data-color="#ef4444" title="赤" onclick="setColor('#ef4444')" style="background-color: #ef4444;"></button>
      <button class="color-btn" data-color="#22c55e" title="緑" onclick="setColor('#22c55e')" style="background-color: #22c55e;"></button>
      <button class="color-btn" data-color="#eab308" title="黄" onclick="setColor('#eab308')" style="background-color: #eab308;"></button>
      <button class="color-btn" data-color="#a855f7" title="紫" onclick="setColor('#a855f7')" style="background-color: #a855f7;"></button>
      <button class="color-btn" data-color="#f97316" title="オレンジ" onclick="setColor('#f97316')" style="background-color: #f97316;"></button>
      <button class="color-btn" data-color="#1f2937" title="黒" onclick="setColor('#1f2937')" style="background-color: #1f2937;"></button>
      <button class="color-btn" data-color="#6b7280" title="グレー" onclick="setColor('#6b7280')" style="background-color: #6b7280;"></button>
    </div>

    <div class="toolbar-divider"></div>

    <!-- グリッド・ズーム -->
    <div class="toolbar-group">
      <button class="toolbar-button" onclick="toggleGrid()" title="グリッド表示">
        ⊞ グリッド
      </button>
      <span style="font-size: 12px; color: #64748b; font-weight: 600;">ズーム:</span>
      <button class="zoom-btn" onclick="zoomOut()">−</button>
      <span id="zoom-level" style="font-size: 12px; font-weight: bold; min-width: 40px; text-align: center;">100%</span>
      <button class="zoom-btn" onclick="zoomIn()">+</button>
      <button class="zoom-btn" onclick="resetZoom()">リセット</button>
    </div>

    <div style="flex: 1;"></div>

    <!-- 保存ボタン -->
    <button class="save-btn" data-action="click->seat-canvas#save" title="保存">
      💾 保存
    </button>
  </div>

  <div class="canvas-wrapper">
    <canvas id="floor-canvas" data-controller="seat-canvas" data-seat-canvas-target="canvas" data-seat-canvas-template-id-value="<%= @template.id %>" data-seat-canvas-context-value="editor" data-seat-canvas-current-user-id-value="<%= current_user.id %>" data-seat-canvas-can-manage-value="true" style="border: 1px solid #e2e8f0; border-radius: 12px; background-color: #ffffff;"></canvas>
  </div>
</div>
