<style>
  .room-detail-container {
    background-color: #f8fafc;
    min-height: 100vh;
    padding: 32px 64px;
  }

  .detail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    gap: 16px;
  }

  .detail-header-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #64748b;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }

  .back-link:hover {
    color: #334155;
  }

  .room-title {
    font-size: 28px;
    font-weight: bold;
    color: #0f172a;
    margin: 0;
  }

  .room-badge {
    background-color: #eff6ff;
    color: #2563eb;
    padding: 4px 10px;
    border-radius: 99px;
    font-size: 12px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .detail-header-actions {
    display: flex;
    gap: 12px;
  }

  .editor-toolbar {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 16px;
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 16px;
  }

  .toolbar-group {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .toolbar-divider {
    width: 1px;
    height: 24px;
    background-color: #e2e8f0;
  }

  .toolbar-button {
    background: white;
    border: 1px solid #e2e8f0;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 500;
    font-size: 13px;
    color: #475569;
    display: flex;
    gap: 4px;
    align-items: center;
    transition: all 0.2s;
  }

  .toolbar-button:hover {
    background-color: #f8fafc;
    border-color: #cbd5e1;
  }

  .toolbar-button.active {
    background-color: #3b82f6;
    color: white;
    border-color: #3b82f6;
  }

  .action-button {
    background: white;
    border: 1px solid #e2e8f0;
    padding: 10px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    color: #334155;
    display: flex;
    gap: 8px;
    align-items: center;
    text-decoration: none;
  }

  .action-button:hover {
    background-color: #f8fafc;
  }

  .main-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .map-container {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .map-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .map-title {
    font-size: 16px;
    font-weight: 600;
    color: #0f172a;
  }

  .legend {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .legend-item {
    display: flex;
    gap: 6px;
    align-items: center;
    font-size: 13px;
    color: #475569;
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .legend-dot.occupied {
    background-color: #3b82f6;
  }

  .legend-dot.available {
    background-color: #94a3b8;
  }

  .occupancy-stat {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
  }

  .floor-canvas {
    background-color: #1e293b;
    border-radius: 12px;
    padding: 40px;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-x: auto;
  }

  .desk-cluster {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: fit-content;
  }

  .desk-row {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .desk-seat {
    width: 80px;
    height: 80px;
    border: 2px solid #94a3b8;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.07);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    flex-shrink: 0;
  }

  .desk-seat:hover {
    transform: scale(1.05);
  }

  .desk-seat.occupied {
    border-color: #3b82f6;
    background-color: rgba(37, 99, 235, 0.2);
  }

  .desk-seat.available {
    border-color: #10b981;
  }

  .desk-seat-label {
    font-size: 12px;
    font-weight: 600;
    color: white;
    opacity: 0.6;
  }

  .desk-seat-indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .desk-seat-indicator.occupied {
    background-color: #3b82f6;
  }

  .desk-seat-indicator.available {
    background-color: #94a3b8;
  }

  .list-panel {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: fit-content;
    max-height: 600px;
    overflow-y: auto;
  }

  .list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .list-title {
    font-size: 16px;
    font-weight: 600;
    color: #0f172a;
  }

  .export-button {
    background: white;
    border: 1px solid #e2e8f0;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 13px;
    color: #334155;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .export-button:hover {
    background-color: #f8fafc;
  }

  .seat-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .seat-table-header {
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    position: sticky;
    top: 0;
  }

  .seat-table-header th {
    padding: 8px 12px;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
  }

  .seat-table-row {
    border-bottom: 1px solid #f1f5f9;
  }

  .seat-table-row:last-child {
    border-bottom: none;
  }

  .seat-table-row td {
    padding: 12px;
    color: #1e293b;
  }

  .seat-id {
    font-weight: 600;
    width: 80px;
  }

  .seat-user {
    width: 160px;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .seat-user-avatar {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .seat-status {
    width: 100px;
    font-size: 13px;
  }

  .seat-status.occupied {
    color: #2563eb;
    font-weight: 600;
  }

  .seat-status.available {
    color: #94a3b8;
  }

  .seat-action {
    text-align: right;
    flex: 1;
  }

  .action-btn {
    background: white;
    border: 1px solid #e2e8f0;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 13px;
    color: #475569;
    text-decoration: none;
    display: inline-block;
  }

  .action-btn:hover {
    background-color: #f8fafc;
  }

  .action-btn.reserve {
    background-color: #3b82f6;
    color: white;
    border: none;
  }

  .action-btn.reserve:hover {
    background-color: #2563eb;
  }

  .action-btn.release {
    background: white;
    border: 1px solid #e2e8f0;
    color: #334155;
  }

  .divider {
    width: 0;
    height: 16px;
    border-left: 1px solid #e2e8f0;
  }
</style>

<div class="room-detail-container">
  <div class="detail-header">
    <div class="detail-header-left">
      <%= link_to "← 戻る", rooms_path, class: "back-link" %>
      <div class="divider"></div>
      <h1 class="room-title"><%= @room.name %></h1>
      <span class="room-badge">
        👥 <%= @room.seat_count %> 席
      </span>
    </div>
    <div class="detail-header-actions">
      <% if user_signed_in? && current_user.owner_of?(@room) %>
        <%= link_to "設定", edit_room_path(@room), class: "action-button" %>
      <% end %>
    </div>
  </div>

  <!-- Editor Toolbar -->
  <div class="editor-toolbar">
    <div class="toolbar-group">
      <span style="font-size: 12px; color: #64748b; font-weight: 600;">編集モード:</span>
      <button class="toolbar-button active" onclick="setEditMode('select')" id="mode-select" title="選択ツール (S)">
        ✓ 選択
      </button>
      <button class="toolbar-button" onclick="setEditMode('draw')" id="mode-draw" title="描画ツール (D)">
        ✏️ 描画
      </button>
      <button class="toolbar-button" onclick="setEditMode('delete')" id="mode-delete" title="削除ツール (Del)">
        🗑️ 削除
      </button>
    </div>
    <div class="toolbar-divider"></div>
    <div class="toolbar-group">
      <button class="toolbar-button" onclick="undoEdit()" title="やり直す (Ctrl+Z)">
        ↶ やり直す
      </button>
      <button class="toolbar-button" onclick="redoEdit()" title="再実行 (Ctrl+Y)">
        ↷ 再実行
      </button>
    </div>
    <div class="toolbar-divider"></div>
    <div class="toolbar-group">
      <button class="toolbar-button" onclick="resetCanvas()" title="リセット">
        🔄 リセット
      </button>
    </div>
    <div style="flex: 1;"></div>
    <div class="toolbar-group">
      <button class="toolbar-button" onclick="saveCanvas()" style="background-color: #10b981; color: white; border-color: #10b981;">
        💾 保存
      </button>
    </div>
  </div>

  <div class="main-split">
    <div class="map-container">
      <div class="map-header">
        <div class="map-title">座席配置図エディタ</div>
        <div class="legend">
          <div class="legend-item">
            <div class="legend-dot occupied"></div>
            使用中 (<%= @room.occupied_seat_count %>)
          </div>
          <div class="legend-item">
            <div class="legend-dot available"></div>
            空き (<%= @room.seat_count - @room.occupied_seat_count %>)
          </div>
          <div class="occupancy-stat">
            稼働率: <%= @room.occupancy_rate %>% (<%= @room.occupied_seat_count %>/<%= @room.seat_count %>席)
          </div>
        </div>
      </div>

      <div class="floor-canvas" data-controller="seat-canvas" data-seat-canvas-room-id-value="<%= @room.id %>">
        <canvas data-seat-canvas-target="canvas" style="width: 100%; height: 100%; display: block; border-radius: 12px;"></canvas>
      </div>
    </div>
  </div>
</div>

<script>
  let currentEditMode = 'select';

  function setEditMode(mode) {
    currentEditMode = mode;

    // ボタンの状態を更新
    document.querySelectorAll('.toolbar-button').forEach(btn => {
      btn.classList.remove('active');
    });
    document.getElementById(`mode-${mode}`)?.classList.add('active');

    // コンソールに出力（デバッグ用）
    console.log(`Edit mode changed to: ${mode}`);
  }

  function undoEdit() {
    console.log('Undo action triggered');
    // TODO: Undo 機能を実装
  }

  function redoEdit() {
    console.log('Redo action triggered');
    // TODO: Redo 機能を実装
  }

  function resetCanvas() {
    if (confirm('座席配置図をリセットしますか？')) {
      console.log('Canvas reset triggered');
      // TODO: Canvas リセット機能を実装
    }
  }

  function saveCanvas() {
    console.log('Canvas save triggered');
    // TODO: Canvas 保存機能を実装
    alert('座席配置図を保存しました');
  }

  // キーボードショートカット
  document.addEventListener('keydown', (e) => {
    if (e.key === 's' || e.key === 'S') setEditMode('select');
    if (e.key === 'd' || e.key === 'D') setEditMode('draw');
    if (e.key === 'Delete') setEditMode('delete');
    if (e.ctrlKey && e.key === 'z') undoEdit();
    if (e.ctrlKey && e.key === 'y') redoEdit();
  });
</script>
