<style>
  .rooms-index {
    background-color: #f8fafc;
    min-height: 100vh;
    padding: 32px 64px;
  }
  .rooms-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
  }
  .rooms-header h1 {
    font-size: 28px;
    font-weight: bold;
    color: #0f172a;
    margin: 0;
  }
  .rooms-header .subtitle {
    font-size: 14px;
    color: #475569;
    margin: 4px 0 0 0;
  }
  .btn-create-room {
    background-color: #3b82f6;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    display: flex;
    gap: 8px;
    align-items: center;
    text-decoration: none;
  }
  .btn-create-room:hover {
    background-color: #2563eb;
  }
  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(421px, 1fr));
    gap: 24px;
  }
  .room-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.02);
    display: flex;
    flex-direction: column;
  }
  .room-card-header {
    padding: 0;
    border-bottom: none;
  }
  .room-thumbnail {
    width: 100%;
    height: 160px;
    object-fit: cover;
    display: block;
  }
  .room-card-info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .room-card-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .room-card-title strong {
    font-size: 18px;
    font-weight: bold;
    color: #0f172a;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .room-status-badge {
    background-color: #eff6ff;
    color: #3b82f6;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }
  .room-status-badge.unused {
    background-color: #f8fafc;
    color: #94a3b8;
  }
  .occupancy-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .occupancy-row {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: #475569;
  }
  .occupancy-row .count {
    font-weight: 600;
    color: #0f172a;
  }
  .progress-bar {
    width: 100%;
    height: 6px;
    background-color: #e2e8f0;
    border-radius: 3px;
    overflow: hidden;
  }
  .progress-fill {
    background-color: #3b82f6;
    height: 100%;
    border-radius: 3px;
  }
  .room-card-footer {
    padding: 12px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #e2e8f0;
  }
  .avatar-row {
    display: flex;
    align-items: center;
    gap: -8px;
  }
  .avatar-row .avatar {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    margin-right: -8px;
    border: 1.5px solid white;
    object-fit: cover;
    display: block;
  }
  .avatar-row .avatar:last-child {
    margin-right: 0;
  }
  .avatar-plus {
    width: 24px;
    height: 24px;
    background-color: #e2e8f0;
    border: 1.5px solid white;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 600;
    color: #475569;
    margin-right: 0;
  }
  .update-time {
    font-size: 12px;
    color: #94a3b8;
  }
  .empty-state {
    text-align: center;
    padding: 48px 20px;
    color: #94a3b8;
  }
  .empty-state p {
    font-size: 14px;
    margin: 8px 0;
  }
</style>

<div class="rooms-index">
  <div class="rooms-header">
    <div>
      <h1>ルーム一覧</h1>
      <p class="subtitle">各エリアおよび会議室の稼働率・座席予約状況</p>
    </div>
    <%= link_to "新規ルーム", new_room_path, class: "btn-create-room" %>
  </div>

  <% if @rooms.any? %>
    <div class="rooms-grid">
      <% @rooms.each do |room| %>
        <div class="room-card">
          <div class="room-card-header">
            <% if room.description.present? %>
              <img src="<%= room.description %>" alt="<%= room.name %>" class="room-thumbnail">
            <% else %>
              <div style="width: 100%; height: 160px; background-color: #e2e8f0;"></div>
            <% end %>
          </div>

          <div class="room-card-info">
            <div class="room-card-title">
              <strong><%= link_to room.name, room_path(room), style: "color: inherit; text-decoration: none;" %></strong>
              <span class="room-status-badge <%= room.occupied_seat_count > 0 ? '' : 'unused' %>">
                <%= room.occupied_seat_count > 0 ? "使用中" : "未使用" %>
              </span>
            </div>

            <div class="occupancy-section">
              <div class="occupancy-row">
                <span>使用中の座席</span>
                <span class="count"><%= room.occupied_seat_count %>/<%= room.seat_count %>席</span>
              </div>
              <div class="progress-bar">
                <% if room.seat_count > 0 %>
                  <% percentage = (room.occupied_seat_count.to_f / room.seat_count) * 100 %>
                  <div class="progress-fill" style="width: <%= percentage %>%;"></div>
                <% end %>
              </div>
            </div>
          </div>

          <div class="room-card-footer">
            <div class="avatar-row">
              <% active_users = room.seats.joins(:sessions).where(sessions: { status: :active }).map { |s| s.sessions.where(status: :active).last&.user }.compact.uniq %>
              <% active_users.first(3).each do |user| %>
                <% if user.present? %>
                  <div class="avatar" style="background-color: #e2e8f0;"></div>
                <% end %>
              <% end %>
              <% if active_users.count > 3 %>
                <div class="avatar-plus">+<%= active_users.count - 3 %></div>
              <% elsif active_users.empty? %>
                <span style="font-size: 12px; color: #94a3b8;">アクティブユーザーなし</span>
              <% end %>
            </div>
            <span class="update-time">updated <%= time_ago_in_words(room.updated_at) %>前</span>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p>ルームがまだ作成されていません</p>
      <p>
        <%= link_to "ルームを追加する", new_room_path, class: "btn-create-room" %>
      </p>
    </div>
  <% end %>
</div>
