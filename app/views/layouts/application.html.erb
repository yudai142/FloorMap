<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Floor Map" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Floor Map">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Vite entrypoint with CSS and JS %>
    <% unless Rails.env.test? %>
      <%= vite_javascript_tag "application.jsx", "data-turbo-track": "reload" %>
      <%= vite_stylesheet_tag "application.jsx", "data-turbo-track": "reload" %>
    <% end %>
  </head>

  <body>
    <div id="root"></div>
    <%= yield %>
    <script>
      // Completely disable Vite HMR
      window.__VITE_HMR__ = false
      window.__VITE_HMR_PROTOCOL__ = null
      window.__VITE_HMR_HOSTNAME__ = null
      window.__VITE_HMR_PORT__ = null

      // Suppress HMR-related console messages
      const originalError = console.error
      const originalWarn = console.warn

      console.error = function(...args) {
        const message = (args[0]?.toString?.() || '').toLowerCase()
        if (message.includes('vite') || message.includes('websocket') || message.includes('hmr')) {
          return
        }
        originalError.apply(console, args)
      }

      console.warn = function(...args) {
        const message = (args[0]?.toString?.() || '').toLowerCase()
        if (message.includes('vite') || message.includes('websocket') || message.includes('hmr')) {
          return
        }
        originalWarn.apply(console, args)
      }
    </script>
  </body>
</html>
