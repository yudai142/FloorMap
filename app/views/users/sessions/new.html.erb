<h2>Log in</h2>

<form action="<%= user_session_path %>" method="POST">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

  <div class="field">
    <p><label for="user_email">Email</label></p>
    <p><input type="email" name="user[email]" id="user_email" autofocus autocomplete="email"></p>
  </div>

  <div class="field">
    <p><label for="user_password">Password</label></p>
    <p><input type="password" name="user[password]" id="user_password" autocomplete="current-password"></p>
  </div>

  <div class="field">
    <p><input type="checkbox" name="user[remember_me]" id="user_remember_me" value="1"></p>
    <p><label for="user_remember_me">Remember me</label></p>
  </div>

  <div class="actions">
    <button type="submit" name="commit" value="Log in">Log in</button>
  </div>
</form>

<%= render "users/shared/links" %>
