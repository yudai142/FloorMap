<div class="bg-white px-5 py-5 flex gap-4 items-start <%= 'opacity-70' if read %>">
  <!-- Status Dot -->
  <div class="pt-1 flex-shrink-0">
    <% if read %>
      <div class="w-2 h-2 rounded-full bg-gray-400"></div>
    <% else %>
      <div class="w-2 h-2 rounded-full bg-blue-500"></div>
    <% end %>
  </div>

  <!-- Icon -->
  <div class="flex-shrink-0">
    <% case notification.notification_type %>
      <% when "check_in" %>
        <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center">
          <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 15l-3-3m0 0l3-3m-3 3h8M3 12a9 9 0 1118 0 9 9 0 01-18 0z"/>
          </svg>
        </div>
      <% when "check_out" %>
        <div class="w-10 h-10 bg-gray-100 rounded-xl flex items-center justify-center">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
        </div>
      <% when "system_update" %>
        <div class="w-10 h-10 bg-green-50 rounded-xl flex items-center justify-center">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
        </div>
      <% when "warning" %>
        <div class="w-10 h-10 bg-red-50 rounded-xl flex items-center justify-center">
          <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4v2m0 0a9 9 0 11-9-9 9 9 0 019 9z"/>
          </svg>
        </div>
    <% end %>
  </div>

  <!-- Content -->
  <div class="flex-1 min-w-0">
    <p class="text-sm text-slate-900 leading-relaxed">
      <%= simple_format(notification.title) %>
    </p>
    <p class="text-xs text-gray-500 mt-2 line-clamp-2">
      <%= notification.body %>
    </p>

    <!-- Metadata -->
    <div class="flex items-center gap-3 mt-2">
      <span class="text-xs text-gray-500"><%= time_ago_in_words(notification.created_at) %>前</span>
      <span class="w-1 h-1 bg-gray-400 rounded-full"></span>
      <span class="text-xs font-semibold <%= notification_type_color(notification.notification_type) %>">
        <%= notification_type_label(notification.notification_type) %>
      </span>
    </div>
  </div>

</div>
