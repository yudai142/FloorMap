<div class="bg-gray-50 min-h-screen">
  <div class="px-16 py-10 max-w-6xl mx-auto">
    <!-- Page Header -->
    <div class="flex items-center justify-between mb-8">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-900 mb-2">通知</h1>
        <p class="text-sm text-slate-600">オフィス内のチェックイン状況、座席予約、システム更新などの履歴</p>
      </div>
      <div class="flex gap-4">
        <%= form_with local: true, method: :patch, url: mark_all_as_read_notifications_path, class: "inline" do |f| %>
          <%= f.submit "すべて既読にする", class: "px-5 py-2 bg-white border border-gray-200 rounded-lg text-sm font-semibold text-slate-600 hover:bg-gray-50 transition" %>
        <% end %>
        <button class="p-2 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition">
          <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Notifications Container -->
    <div class="space-y-8">
      <!-- Unread Section -->
      <% if @unread_notifications.any? %>
        <div>
          <div class="flex items-center gap-2 mb-4">
            <h2 class="text-sm font-bold text-blue-500">新しい</h2>
            <span class="bg-blue-500 text-white text-xs font-semibold px-2 py-1 rounded-full"><%= @unread_notifications.count %></span>
          </div>
          <div class="bg-gray-200 rounded-2xl overflow-hidden divide-y divide-gray-300">
            <% @unread_notifications.each do |notification| %>
              <%= render "notification_item", notification: notification, read: false %>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Read Section -->
      <% if @read_notifications.any? %>
        <div>
          <h2 class="text-sm font-bold text-slate-600 mb-4">既読</h2>
          <div class="bg-gray-200 rounded-2xl overflow-hidden divide-y divide-gray-300">
            <% @read_notifications.each do |notification| %>
              <%= render "notification_item", notification: notification, read: true %>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Empty State -->
      <% if @unread_notifications.empty? && @read_notifications.empty? %>
        <div class="text-center py-12">
          <p class="text-gray-500 text-sm">通知はありません</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
